NDT_MODEL_PATH=models/best.pt
NDT_MODEL_VERSION=1.0.0
MAX_IMAGE_BYTES=10485760

# Max decoded pixel count (width * height) allowed before an upload is
# rejected. Protects against decompression-bomb style images that are small
# on disk but enormous once decoded.
MAX_IMAGE_PIXELS=25000000

# Set to "false" to disable the /docs (Swagger UI) endpoint in production.
ENABLE_DOCS=true

# Comma-separated list of frontend origins allowed to call this API.
# Required for the browser to be able to reach /api/v1/predict at all.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. If set, every request must include a matching `X-API-Key` header.
# Leave unset for local development; set it before deploying anywhere public
# so the inference endpoint can't be hit anonymously.
NDT_API_KEY=

# Requests per client IP per minute allowed on /api/v1/predict. 0 disables it.
RATE_LIMIT_PER_MINUTE=20

# Demo/simulation is disabled by default. Enable both flags only for local UI testing.
DEMO_MODE=false
ALLOW_SIMULATION=false
